# 通用忽略规则

# Node.js 构建文件和依赖
node_modules/
dist/
build/

# 日志文件
*.log
logs/

# 环境变量文件
.env
.env.* # 忽略多环境配置文件，如 .env.production, .env.development

# IDE 和编辑器配置文件
.vscode/
.idea/

# 临时文件
*.tmp
*.temp
*.swp
*.swo

# 系统文件
.DS_Store  # macOS
Thumbs.db  # Windows

# 其他常见文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 前端项目忽略规则

# Vite 构建文件夹
dist/
build/

# 依赖文件夹
node_modules/

# 缓存文件
.vite/
*.cache/

# 后端项目忽略规则

# 数据库文件
*.db
*.sqlite

# 临时文件
/tmp/
